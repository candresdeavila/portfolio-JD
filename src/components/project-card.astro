---
import { Icon } from 'astro-icon/components';

interface Props {
  project: {
    title: string;
    description: string;
    images: string[];
    mediaSize?: {
      width: number;
      height: number;
      displayWidth?: number;
    };
    tech: string[];
    platforms: string[];
    link: string;
    category: string;
  };
}

const { project } = Astro.props;

const isSlider = project.images.length > 1;
const isVideo = (src: string) => /\.(mp4|webm|ogg)$/i.test(src);
const mediaSize = project.mediaSize;
const naturalMediaSize = mediaSize?.width && mediaSize?.height ? mediaSize : undefined;
const hasNaturalMediaSize = Boolean(naturalMediaSize);
const mediaDisplayWidth = naturalMediaSize?.displayWidth ?? naturalMediaSize?.width;
const mediaFrameStyle = naturalMediaSize
  ? `aspect-ratio: ${naturalMediaSize.width} / ${naturalMediaSize.height}; max-width: ${mediaDisplayWidth}px; margin-inline: auto;`
  : undefined;
---

<div
  class="project-card group relative w-full bg-white/5 border border-white/10 rounded-2xl overflow-hidden hover:border-accent/40 transition-all duration-500"
>
  <div
    class={`${hasNaturalMediaSize ? '' : 'aspect-video'} overflow-hidden relative bg-[#1a1a1a]`}
    style={mediaFrameStyle}
  >
    <div class="absolute inset-0 bg-accent/10 group-hover:bg-transparent transition-colors z-10 pointer-events-none"></div>
    
    <div class={`w-full h-full relative ${isSlider ? 'image-slider' : ''}`}>
      {project.images.map((media, index) => (
        isVideo(media) ? (
          <video
            src={media}
            aria-label={`${project.title} video ${index + 1}`}
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            width={naturalMediaSize?.width}
            height={naturalMediaSize?.height}
            class={`absolute inset-0 w-full h-full ${hasNaturalMediaSize ? 'object-contain' : 'object-cover group-hover:scale-110'} transition-all duration-1000 ${index === 0 ? 'opacity-100 z-0' : 'opacity-0 z-[-1]'}`}
          />
        ) : (
          <img 
            src={media}
            alt={`${project.title} screenshot ${index + 1}`}
            onerror="this.removeAttribute('onerror');this.setAttribute('src','/placeholder.jpeg');"
            class={`absolute inset-0 w-full h-full object-cover transition-all duration-1000 group-hover:scale-110 ${index === 0 ? 'opacity-100 z-0' : 'opacity-0 z-[-1]'}`}
          />
        )
      ))}
    </div>
    
    <div class="absolute top-3 right-3 flex gap-2 z-20">
      {project.platforms.map((p) => (
        <div class="p-1.5 bg-black/60 backdrop-blur-md rounded-lg border border-white/10 text-white/80">
          <Icon name={`mdi:${p}`} class="w-4 h-4" />
        </div>
      ))}
    </div>
  </div>

  <div class="p-6 space-y-4">
    <div class="flex justify-between items-start">
      <div>
        <span class="text-accent text-[10px] uppercase tracking-widest font-bold">{project.category}</span>
        <h3 class="text-xl font-heading font-bold text-white mt-1">{project.title}</h3>
      </div>
      <a href={project.link} target="_blank" class="text-white/40 hover:text-accent transition-colors">
        <Icon name="mdi:open-in-new" class="w-6 h-6" />
      </a>
    </div>

    <p class="text-gray-400 text-sm font-body line-clamp-3">
      {project.description}
    </p>

    <div class="flex flex-wrap gap-2 pt-2">
      {project.tech.map((t) => (
        <span class="px-2 py-1 bg-white/5 rounded-md text-[10px] text-white/60 border border-white/5">
          {t}
        </span>
      ))}
    </div>
  </div>
</div>

<script>
  function initSliders() {
    const sliders = document.querySelectorAll('.image-slider');
    
    sliders.forEach(slider => {
      const mediaItems = slider.querySelectorAll('img, video');
      if (mediaItems.length <= 1) return;

      let currentIndex = 0;
      setInterval(() => {
        // Hide current
        mediaItems[currentIndex].classList.remove('opacity-100', 'z-0');
        mediaItems[currentIndex].classList.add('opacity-0', 'z-[-1]');
        
        // Move to next
        currentIndex = (currentIndex + 1) % mediaItems.length;
        
        // Show next
        mediaItems[currentIndex].classList.remove('opacity-0', 'z-[-1]');
        mediaItems[currentIndex].classList.add('opacity-100', 'z-0');
      }, 3500);
    });
  }

  initSliders();
  document.addEventListener('astro:after-swap', initSliders);
</script>

<style is:global>
  .project-card {
    opacity: 0;
    visibility: hidden;
    transform: translateY(40px);
    transition: 
      opacity 0.8s ease-out, 
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0.8s;
    will-change: transform, opacity;
  }

  .project-card.reveal {
    opacity: 1 !important;
    visibility: visible !important;
    transform: translateY(0) !important;
  }
</style>
